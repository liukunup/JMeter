# Use the specified JMeter image as the base image
ARG BASE_JMETER_IMAGE=liukunup/jmeter:5.6.3
FROM ${BASE_JMETER_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    NM_USERNAME="jmeter" \
    NM_PASSWORD=""

# Install NoMachine
# link https://kb.nomachine.com/DT08U00297?s=docker
RUN apt-get update && apt-get install -y \
    apt-utils vim xterm cups curl \
    xfce4 \
    xfce4-goodies \
    xubuntu-icon-theme \
    && curl -fSL "https://www.nomachine.com/free/linux/64/deb" -o nomachine.deb \
    && dpkg -i nomachine.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket

ENTRYPOINT [ "/entrypoint.sh" ]

CMD [ "nomachine" ]
