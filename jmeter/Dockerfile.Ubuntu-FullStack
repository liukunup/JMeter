# Use the specified JMeter image as the base image
ARG BASE_JMETER_IMAGE
FROM ${BASE_JMETER_IMAGE}

# Set your password for RDP access, or use auto-generated password
ENV RDP_PASSWORD=""

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    sudo git \
    # 
    xvfb \
    xfce4 xfce4-goodies \
    x11vnc \
    novnc websockify \
    xrdp \
    supervisor \
    # Clean up apt cache to reduce image size
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # Use XFCE as the default session
    && echo "xfce4-session" > ~/.xsession \
    # Change xRDP port to avoid default port conflicts
    && sed -i 's/port=3389/port=3390/g' /etc/xrdp/xrdp.ini \
    && service xrdp restart

COPY jmeter/supervisord-fullstack.conf /etc/supervisor/conf.d/supervisord.conf

# Set DISPLAY environment variable (for X11 forwarding)
ENV DISPLAY=":1"

# Expose ports for RDP and VNC/NoVNC
# - 3389 : RDP
# - 5900 : VNC
# - 6080 : NoVNC
EXPOSE 3389 5900 6080

ENTRYPOINT [ "/entrypoint.sh" ]

CMD [ "vnc" ]
