# Use the specified JMeter image as the base image
ARG BASE_JMETER_IMAGE
FROM ${BASE_JMETER_IMAGE}

# Set your password for VNC access, or use auto-generated password
ENV VNC_PASSWORD=""

ENV DISPLAY=":1"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    # 
    sudo openssl \
    # 
    xvfb \
    xfce4 xfce4-goodies \
    x11vnc \
    novnc websockify \
    supervisor \
    # 
    pulseaudio pulseaudio-utils pavucontrol \
    && apt-get autoclean \
    && rm -rf /var/lib/apt/lists/*

COPY jmeter/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose ports for VNC and NoVNC
# - 5900 : VNC
# - 6080 : NoVNC
EXPOSE 5900 6080

ENTRYPOINT [ "/entrypoint.sh" ]

CMD [ "vnc" ]
