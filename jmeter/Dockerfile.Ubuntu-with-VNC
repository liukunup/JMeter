# Use the specified JMeter image as the base image
ARG BASE_JMETER_IMAGE_VERSION=latest
FROM liukunup/jmeter:${BASE_JMETER_IMAGE_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# Install packages
RUN apt-get update && apt-get install -y \
    # Pulse Audio
    pulseaudio \
    pulseaudio-utils \
    pavucontrol \
    # Xfce 4
    xfce4 \
    xfce4-goodies \
    # Other dependencies
    sudo \
    supervisor \
    x11vnc \
    xvfb \
    novnc \
    websockify \
    && chmod +x /entrypoint.sh \
    && apt-get autoclean \
    && apt-get autoremove \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 5900 6080

ENTRYPOINT ["/entrypoint.sh", "vnc"]
