# Use the specified JMeter image as the base image
ARG BASE_JMETER_IMAGE
FROM ${BASE_JMETER_IMAGE}

ENV DISPLAY=":1"

ENV VNC_PASSWORD=""

ENV DEBIAN_FRONTEND=noninteractive

# Install packages
RUN apt-get update && apt-get install -y \
    # PulseAudio
    pulseaudio \
    pulseaudio-utils \
    pavucontrol \
    # Xfce 4
    xfce4 \
    xfce4-goodies \
    # Other dependencies
    sudo \
    supervisor \
    x11vnc \
    xvfb \
    novnc \
    websockify \
    openssl \
    && apt-get autoclean \
    && apt-get autoremove \
    && rm -rf /var/lib/apt/lists/*

COPY jmeter/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 5900 6080

ENTRYPOINT [ "/entrypoint.sh" ]

CMD [ "vnc" ]
